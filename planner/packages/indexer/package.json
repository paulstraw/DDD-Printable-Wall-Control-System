{
  "name": "@ddd-planner/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node build step: reads the repo's STLs, emits glTF, thumbnails and index.json.",
  "bin": {
    "ddd-index": "./src/cli.ts"
  },
  "scripts": {
    "index": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx src/spike.ts",
    "audit": "tsx src/audit-cli.ts",
    "playground": "tsx src/playground.ts"
  },
  "dependencies": {
    "@ddd-planner/core": "*",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "meshoptimizer": "^0.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}
