{
  "name": "ddd-wall-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "3D layout planner for the DDD Printable Wall Control System",
  "workspaces": [
    "packages/core",
    "packages/indexer",
    "packages/app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ddd-planner/app",
    "build": "npm run build --workspace @ddd-planner/app",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "index": "npm run index --workspace @ddd-planner/indexer"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
